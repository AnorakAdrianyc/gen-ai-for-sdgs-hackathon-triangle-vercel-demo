{
  "meta": {
    "dataset": "hk-building-safety-demo",
    "version": "1.0.0",
    "updated": "2026-09-30",
    "disclaimer": "Illustrative sample records for a static demo. Not a Buildings Department assessment, not a survey, and not a statement about any real estate, owners' corporation, or management company.",
    "motive": {
      "event": "Wang Fuk Court fire, Tai Po",
      "date": "2025-11-26",
      "deaths": 168,
      "injured": 79,
      "note": "Wang Fuk Court is not one of the sample buildings and is not given a risk score.",
      "source": "https://www.info.gov.hk/gia/general/202601/15/P2026011500613.htm"
    },
    "howToRead": "The desk loads this file and nothing else. Map blocks use scene.x, scene.y, scene.w, scene.d and scene.floors. Colour uses risk.level. The score panel sums factorPoints and checks it against scoring.bands. The detail panel hides fields the selected role is not listed under in visibility."
  },
  "scoring": {
    "method": "Sum of factor points, clamped conceptually to 0–100.",
    "factors": [
      {
        "id": "age",
        "label": "Building age",
        "max": 20
      },
      {
        "id": "inspectionGap",
        "label": "Years past a statutory inspection window",
        "max": 25
      },
      {
        "id": "openOrders",
        "label": "Open statutory orders",
        "max": 20
      },
      {
        "id": "fireSafety",
        "label": "Outstanding fire-safety items",
        "max": 20
      },
      {
        "id": "unverifiedParty",
        "label": "OC or manager not verified on the network",
        "max": 15
      }
    ],
    "bands": [
      { "id": "low", "label": "Low", "min": 0, "max": 39 },
      { "id": "medium", "label": "Medium", "min": 40, "max": 69 },
      { "id": "high", "label": "High", "min": 70, "max": 100 }
    ]
  },
  "visibility": {
    "riskProfile": [
      "resident",
      "owners-corporation",
      "property-manager",
      "contractor",
      "inspector",
      "regulator"
    ],
    "defectNarrative": [
      "resident",
      "owners-corporation",
      "property-manager",
      "inspector",
      "regulator"
    ],
    "statutoryOrders": [
      "owners-corporation",
      "property-manager",
      "inspector",
      "regulator"
    ],
    "tenderQuotes": ["owners-corporation", "property-manager"],
    "residentContact": ["owners-corporation", "property-manager"],
    "contractorLicence": [
      "owners-corporation",
      "property-manager",
      "contractor",
      "inspector",
      "regulator"
    ]
  },
  "network": {
    "title": "A dispatch network for building care",
    "summary": "A building case moves like a trip. A person asks, a verified provider is matched, and the platform keeps one record both sides can trust. Nobody has to hand a stranger the keys to the whole building file.",
    "record": {
      "id": "case-record",
      "name": "Case record",
      "uberAnalogue": "The trip",
      "summary": "One thread, one building, one scope of work. Photos, quotes, and sign-offs attach here instead of in a private chat."
    },
    "roles": [
      {
        "id": "resident",
        "name": "Resident",
        "uberAnalogue": "Rider",
        "authenticatesWith": [
          "A unit binding for one flat in one building",
          "An invitation or one-time code from the owners' corporation or manager"
        ],
        "canSee": [
          "Their own reports",
          "The building risk band",
          "Public status of cases in that building"
        ],
        "canDo": [
          "File a defect",
          "Attach photos",
          "Confirm a time for access"
        ],
        "cannot": [
          "Read other flats' private notes",
          "See tender prices",
          "Award a contract"
        ]
      },
      {
        "id": "owners-corporation",
        "name": "Owners' corporation",
        "uberAnalogue": "Account holder",
        "authenticatesWith": [
          "OC registration checked against a statutory extract",
          "Two officers confirm the account"
        ],
        "canSee": ["Cases, orders, quotes, and the risk breakdown"],
        "canDo": [
          "Accept a case",
          "Open a tender",
          "Award a verified contractor"
        ],
        "cannot": [
          "Edit a contractor's licence",
          "Close a statutory order without the inspector"
        ]
      },
      {
        "id": "property-manager",
        "name": "Property manager",
        "uberAnalogue": "Dispatcher",
        "authenticatesWith": [
          "Company registration",
          "A mandate from the OC for that building"
        ],
        "canSee": [
          "The case thread",
          "Quotes",
          "Access notes for open cases"
        ],
        "canDo": [
          "Prepare the tender pack",
          "Propose a shortlist",
          "Schedule access"
        ],
        "cannot": [
          "Award the contract unless the OC has delegated it",
          "Change the public risk band by hand"
        ]
      },
      {
        "id": "contractor",
        "name": "Registered contractor",
        "uberAnalogue": "Driver",
        "authenticatesWith": [
          "A registered licence for the trade",
          "Insurance still in date"
        ],
        "canSee": [
          "Tenders invited to them",
          "The scope of work",
          "Not other bidders' prices"
        ],
        "canDo": [
          "Submit one quote",
          "Update work status",
          "Upload completion photos"
        ],
        "cannot": [
          "See a resident's access note before access is granted",
          "Mark a statutory order closed"
        ]
      },
      {
        "id": "inspector",
        "name": "Licensed inspector",
        "uberAnalogue": "Vehicle inspection",
        "authenticatesWith": [
          "Authorized Person or registered inspector enrolment"
        ],
        "canSee": ["Defects, orders, and the completion record"],
        "canDo": ["Sign off the work", "Reject the work", "Attach an inspection note"],
        "cannot": ["See tender prices", "Message residents outside the case"]
      },
      {
        "id": "regulator",
        "name": "Authority desk",
        "uberAnalogue": "Trust and safety",
        "authenticatesWith": ["A staff identity on the authority side"],
        "canSee": ["Open orders, sign-offs, and the published risk band"],
        "canDo": [
          "Read the statutory trail",
          "Receive a notice when an order stays open"
        ],
        "cannot": [
          "Read private flat complaints that are not statutory",
          "Pick the winning contractor"
        ]
      }
    ],
    "edges": [
      {
        "from": "resident",
        "to": "case-record",
        "label": "Files the case after the unit check"
      },
      {
        "from": "case-record",
        "to": "owners-corporation",
        "label": "Routes to the verified OC"
      },
      {
        "from": "owners-corporation",
        "to": "property-manager",
        "label": "Asks the manager to prepare the pack"
      },
      {
        "from": "property-manager",
        "to": "contractor",
        "label": "Offers the tender to licensed contractors"
      },
      {
        "from": "contractor",
        "to": "inspector",
        "label": "Hands finished work to a licensed checker"
      },
      {
        "from": "inspector",
        "to": "regulator",
        "label": "Statutory closure becomes visible"
      },
      {
        "from": "regulator",
        "to": "resident",
        "label": "The public risk band updates"
      }
    ],
    "journey": [
      {
        "id": "report",
        "title": "Report",
        "uber": "Rider requests a trip",
        "actors": ["resident"],
        "authenticates": "The account is bound to one flat in North Terrace Sample.",
        "message": "Smoke-stop doors on 12/F do not close.",
        "record": "Case NT-441 opens on the building thread."
      },
      {
        "id": "check",
        "title": "Check",
        "uber": "Platform confirms the rider",
        "actors": ["resident"],
        "authenticates": "Unit binding is checked before the case leaves the flat.",
        "message": "Identity matches Flat sample, 12/F. No other flats are attached.",
        "record": "The report is marked authenticated."
      },
      {
        "id": "route",
        "title": "Route",
        "uber": "Trip is offered, not shouted into a group chat",
        "actors": ["owners-corporation"],
        "authenticates": "Two OC officers are already verified for this building.",
        "message": "North Terrace Sample OC receives case NT-441.",
        "record": "Status becomes waiting on the OC."
      },
      {
        "id": "pack",
        "title": "Pack",
        "uber": "Dispatcher sets the pickup details",
        "actors": ["property-manager"],
        "authenticates": "Sample Ridge Management holds a mandate from that OC.",
        "message": "The manager drafts a fire-door tender pack and an access window.",
        "record": "Scope, photos, and access note sit on the case."
      },
      {
        "id": "match",
        "title": "Match",
        "uber": "A licensed driver is offered the trip",
        "actors": ["contractor"],
        "authenticates": "Only licences still in date can see the invitation.",
        "message": "Two sample contractors submit quotes. Each sees the scope, not the other price.",
        "record": "Quotes attach to NT-441."
      },
      {
        "id": "award",
        "title": "Award",
        "uber": "The account holder confirms the ride",
        "actors": ["owners-corporation"],
        "authenticates": "Award needs an OC officer, not the manager alone.",
        "message": "The OC awards Sample Ridge Contractors.",
        "record": "The other quote stays hidden from the winner."
      },
      {
        "id": "signoff",
        "title": "Sign-off",
        "uber": "The vehicle check, after the trip",
        "actors": ["inspector"],
        "authenticates": "A registered inspector, not the contractor, closes the workmanship.",
        "message": "Doors self-close. The inspector rejects nothing and signs the note.",
        "record": "Completion photos and the note join the case."
      },
      {
        "id": "update",
        "title": "Update",
        "uber": "Both sides see the trip receipt",
        "actors": ["regulator", "resident"],
        "authenticates": "The authority desk sees the statutory trail. Residents see the band, not the prices.",
        "message": "The outstanding fire-door item would drop off the sample score.",
        "record": "The map band can move. The audit trail stays."
      }
    ],
    "sampleBuildingId": "north-terrace"
  },
